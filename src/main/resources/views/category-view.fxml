<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--suppress ALL -->

<AnchorPane stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/25.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.CategoryViewController">
   <children>
      <VBox alignment="CENTER" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="TOP_CENTER" spacing="10.0">
               <children>
                   <TextField fx:id="txtSearch" promptText="Search" HBox.hgrow="ALWAYS"/>
                   <MenuButton fx:id="btnSort" mnemonicParsing="false" text="sort by">
                       <items>
                           <MenuItem fx:id="miAtoZ" mnemonicParsing="false" text="A-Z"/>
                           <MenuItem fx:id="miNumOfTracks" mnemonicParsing="false" text="No. of Tracks"/>
                           <CheckMenuItem fx:id="cmiAscending" mnemonicParsing="false" text="Ascending"/>
                       </items>
                   </MenuButton>
                   <Button mnemonicParsing="false" onAction="#handleBackNavigation" text="⬅️"/>
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </HBox>
            <ListView fx:id="contentList" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</AnchorPane>
