<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--suppress ALL -->

<AnchorPane stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/25.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.PlayingTrackViewController">

    <children>
        <VBox alignment="CENTER" spacing="15.0" styleClass="track-container" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <StackPane fx:id="spImageContainer" styleClass="image-circle">
                <children>

                    <ImageView fx:id="imgTrack" fitHeight="400.0" fitWidth="400.0" preserveRatio="true"
                               styleClass="track-image"/>
                </children>
            </StackPane>

            <Label fx:id="lblTitle" alignment="CENTER" maxWidth="500.0" styleClass="track-title" text="No Track Playing"
                   textAlignment="CENTER"/>

            <Label fx:id="lblArtist" alignment="CENTER" maxWidth="350.0" styleClass="track-artist"
                   textAlignment="CENTER"/>
            <Button fx:id="btnChangeArtwork" mnemonicParsing="false" onAction="#handleChangeArtwork"
                    styleClass="more-button" text="change artwork"/>
            <padding>
                <Insets bottom="5.0"/>
            </padding>

        </VBox>
    </children>
</AnchorPane>
