<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      spacing="8.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/25.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.controllers.LyricsViewController">
    <children>
        <HBox alignment="TOP_RIGHT" spacing="4.0">
            <children>
                <Button fx:id="btnSave" mnemonicParsing="false" text="save" visible="false"/>
                <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handelSearch"
                        text="search for lyrics on web"/>
            </children>
        </HBox>
        <StackPane prefHeight="300.0" VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fx:id="spLyricsContainer" fitToWidth="true">
                    <content>
                        <TextFlow fx:id="tflLyricsView" styleClass="lyrics-flow" stylesheets="@../styles/main.css"
                                  textAlignment="CENTER"/>
                    </content>
                </ScrollPane>
                <TextArea fx:id="taLyricsEditor" editable="false"/>
            </children>
        </StackPane>
        <HBox alignment="CENTER">
            <children>
                <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handelEdit" text="edit"/>
            </children>
            <padding>
                <Insets bottom="4.0"/>
            </padding>
        </HBox>
    </children>
</VBox>
