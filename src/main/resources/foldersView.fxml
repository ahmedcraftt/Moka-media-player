<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@styles/mainStyle.css" xmlns="http://javafx.com/javafx/25.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.FoldersViewController">

    <children>

        <VBox spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <children>

                <HBox spacing="5.0">

                    <children>

                        <TextField fx:id="tfSearchBar" promptText="Search folders..." HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnAdd" mnemonicParsing="false" text="Add"/>

                    </children>

                </HBox>

                <ListView fx:id="lvFoldersList" VBox.vgrow="ALWAYS"/>

            </children>

        </VBox>

    </children>

</AnchorPane>
